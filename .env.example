# =============================================================================
# AI Organic Marketing Automation — variáveis de ambiente
# Copie para `.env` e ajuste os valores. NUNCA versione o arquivo `.env`.
# Variáveis são adicionadas aqui no mesmo passo em que passam a ser utilizadas.
# =============================================================================

# --- Geral --------------------------------------------------------------------
NODE_ENV=development
# Containers e aplicação sempre operam em UTC; o timezone de exibição
# vem da configuração de cada organização.
TZ=UTC

# --- Portas expostas no host (docker compose) ---------------------------------
# Publicadas apenas em 127.0.0.1. Ajuste se a porta já estiver em uso no host.
MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6380
# API (PASSO 4) e frontend (PASSO 5)
API_PORT=3000
WEB_PORT=5173

# --- MySQL (container: PASSO 2 · Prisma: PASSO 3) ------------------------------
# Obrigatórias: o docker compose falha com mensagem clara se estiverem ausentes.
MYSQL_DATABASE=aom
MYSQL_USER=aom
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
# URLs de conexão (host `mysql` = rede interna do docker compose). Mantenha usuário e
# senha iguais a MYSQL_USER/MYSQL_PASSWORD; caracteres especiais na senha devem ser
# codificados (ex.: @ → %40).
DATABASE_URL=mysql://aom:change-me@mysql:3306/aom
# Shadow database do `prisma migrate dev` e banco dos testes de integração
# (criados automaticamente como <MYSQL_DATABASE>_shadow e <MYSQL_DATABASE>_test).
SHADOW_DATABASE_URL=mysql://aom:change-me@mysql:3306/aom_shadow
TEST_DATABASE_URL=mysql://aom:change-me@mysql:3306/aom_test
# MySQL 8.4 usa caching_sha2_password: sem TLS, o driver precisa obter a chave pública
# do servidor. Aceitável apenas na rede interna de desenvolvimento; em produção use TLS.
DATABASE_ALLOW_PUBLIC_KEY_RETRIEVAL=true

# --- Redis (PASSO 3) ------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
# Database separado para testes de integração (é esvaziado a cada teste)
TEST_REDIS_URL=redis://redis:6379/15

# --- Segurança (PASSOS 6 e 10) ------------------------------------------------
# Gere valores fortes e distintos, ex.: `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
# Chave de 32 bytes em base64 para criptografia das API Keys: `openssl rand -base64 32`
ENCRYPTION_KEY=change-me
# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:5173

# --- Seeds de desenvolvimento (PASSO 3) ---------------------------------------
# O seed recusa senhas com menos de 12 caracteres ou contendo "change-me".
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=change-me
SEED_SUPER_ADMIN_NAME=Super Admin
